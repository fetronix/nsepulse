{
  "name": "nse-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kenyan market research platform with explicit data provenance and freshness",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "start": "node dist/server/index.js",
    "start:bot": "node dist/server/telegram/standalone.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:check": "tsx src/server/db/check.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "grammy": "^1.35.0",
    "helmet": "^8.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.0.0"
  }
}
