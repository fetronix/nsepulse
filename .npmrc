# Enforce the runtime declared in package.json#engines at install time.
#
# `engines` alone is advisory: npm only prints EBADENGINE and continues. A contributor then
# runs the toolchain on an unsupported Node release and meets a confusing failure much later
# (for example, formatting or coverage output that differs from CI). Failing here is cheaper
# and names the real problem. Use `nvm use` (see .nvmrc) or switch to Node 22.
engine-strict=true
