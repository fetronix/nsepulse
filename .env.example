# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
# Required for durable storage; application starts read-only/degraded without it.
DATABASE_URL=postgres://nse_pulse:change-me@localhost:5432/nse_pulse
DATABASE_SSL=false
# No adapter is enabled until credentials + licensing are configured.
MARKET_DATA_PROVIDER=none
NSE_VENDOR_API_BASE_URL=
NSE_VENDOR_API_KEY=
# Telegram bot polling is disabled unless configured.
TELEGRAM_BOT_TOKEN=
# Required for authenticated sessions in a later auth-enabled deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
ENABLE_SCHEDULER=false
