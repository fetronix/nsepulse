# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
# Required for durable storage; application starts read-only/degraded without it.
# Password and database name match the defaults docker-compose.yml creates, so
# `cp .env.example .env && docker compose up -d db && npm run db:migrate` works as written.
# POSTGRES_PASSWORD / POSTGRES_DB are read by docker-compose only (not by the application).
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=nse_pulse
DATABASE_URL=postgres://nse_pulse:local_dev_only_change_me@localhost:5432/nse_pulse
DATABASE_SSL=false
# Live quote adapter stays disabled until a real provider is selected, contracted and implemented.
# Allowed values: none (default) | nse-vendor (placeholder, makes no request) | demo (fixtures, development only)
MARKET_DATA_PROVIDER=none
# Demo fixtures require this explicit opt-in and are refused when NODE_ENV=production.
ALLOW_DEMO_MARKET_DATA=false
# Placeholders only. Leave blank until NSE/vendor API documentation and licensing are reviewed.
# No default endpoint is invented and credential presence alone never enables live data.
NSE_VENDOR_API_BASE_URL=
NSE_VENDOR_API_KEY=
# Independent sources: set true only after written permission is on file.
# Historical series are otherwise withheld from the API even if rows exist in the database.
HISTORICAL_DATA_PERMISSION_CONFIRMED=false
# Official announcements require their own permission and an enabled, operator-registered source.
ANNOUNCEMENTS_PERMISSION_CONFIRMED=false
# Telegram bot polling is disabled unless configured.
TELEGRAM_BOT_TOKEN=
# Required for authenticated sessions in a later auth-enabled deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Structured logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
ENABLE_SCHEDULER=false
# Container only: apply Drizzle migrations on start (docker/entrypoint.sh). Leave unset locally.
# RUN_MIGRATIONS=true
# Security-master import only (src/server/db/import-securities.ts), supplied per command:
#   SECURITY_MASTER_SOURCE_URL — official document URL the security list was taken from
#   SECURITY_MASTER_VERIFIED_AT — ISO-8601 timestamp when a human verified that source
# Neither has a default; the importer refuses to run without both.
# SECURITY_MASTER_SOURCE_URL=
# SECURITY_MASTER_VERIFIED_AT=
