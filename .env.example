# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
# Required for durable storage; application starts read-only/degraded without it.
# Password and database name match the defaults docker-compose.yml creates, so
# `cp .env.example .env && docker compose up -d db && npm run db:migrate` works as written.
# POSTGRES_PASSWORD / POSTGRES_DB are read by docker-compose only (not by the application).
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=nse_pulse
DATABASE_URL=postgres://nse_pulse:local_dev_only_change_me@localhost:5432/nse_pulse
DATABASE_SSL=false
# Alternative to DATABASE_URL: the same connection expressed as separate variables, for
# environments that keep host/user/password apart. DATABASE_URL wins when both are set.
# Uncomment and fill all four (password may be empty for trust/peer auth) to use this form:
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_DB_NAME=nse_pulse
# SQL_ADMIN_USER=nse_pulse
# SQL_ADMIN_PASSWORD=local_dev_only_change_me
# Live quote adapter stays disabled until a real provider is selected, contracted and implemented.
# Allowed values: none (default) | mansa (requires MANSA_API_KEY) | nse-vendor (placeholder,
# makes no request) | demo (fixtures, development only)
MARKET_DATA_PROVIDER=none
# Demo fixtures require this explicit opt-in and are refused when NODE_ENV=production.
ALLOW_DEMO_MARKET_DATA=false
# Placeholders only. Leave blank until NSE/vendor API documentation and licensing are reviewed.
# No default endpoint is invented and credential presence alone never enables live data.
NSE_VENDOR_API_BASE_URL=
NSE_VENDOR_API_KEY=
# Mansa API (https://mansaapi.com/docs) — Bearer token, HTTPS only.
# Free tier is documented as 100 requests/day: quotes, exchanges, movers and calendars are
# included; per-stock history needs the Pro plan. Data is a delayed snapshot per Mansa's
# documented 30-minute freshness target, never real-time.
# Placeholder only. Put a real key in .env or a secret manager, never in Git or a chat.
MANSA_API_BASE_URL=https://mansaapi.com
MANSA_API_KEY=
# Request timeout for a single Mansa call, in milliseconds.
MANSA_REQUEST_TIMEOUT_MS=10000
# Locally enforced ceiling on outbound Mansa requests per UTC day; the adapter refuses to
# exceed it rather than discovering the limit through 429 responses.
MANSA_DAILY_REQUEST_BUDGET=100
# Snapshot cache lifetime. Matches the documented 30-minute freshness target at the top end;
# the default keeps interactive quotes off the wire.
MANSA_CACHE_TTL_SECONDS=300
# Independent sources: set true only after written permission is on file.
# Historical series are otherwise withheld from the API even if rows exist in the database.
HISTORICAL_DATA_PERMISSION_CONFIRMED=false
# Official announcements require their own permission and an enabled, operator-registered source.
ANNOUNCEMENTS_PERMISSION_CONFIRMED=false
# Telegram bot polling is disabled unless configured.
TELEGRAM_BOT_TOKEN=
# Required for authenticated sessions in a later auth-enabled deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Structured logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
ENABLE_SCHEDULER=false
# Container only: apply Drizzle migrations on start (docker/entrypoint.sh). Leave unset locally.
# RUN_MIGRATIONS=true
# Migrations directory used by `npm run db:migrate`. Defaults to ./drizzle/generated; override
# when mounting migrations elsewhere (read-only image, mounted volume).
# MIGRATIONS_FOLDER=./drizzle/generated
# Security-master import only (src/server/db/import-securities.ts), supplied per command:
#   SECURITY_MASTER_SOURCE_URL — official document URL the security list was taken from
#   SECURITY_MASTER_VERIFIED_AT — ISO-8601 timestamp when a human verified that source
# Neither has a default; the importer refuses to run without both.
# SECURITY_MASTER_SOURCE_URL=
# SECURITY_MASTER_VERIFIED_AT=

# --- Test and integration harness -------------------------------------------------
# These three are read only by the integration suite, the CLI tests and CI. The
# application never reads them, and they are not needed to run the app or the unit
# tests. Leave them unset unless you are running integration tests.
#
# Connection for `npm run test:integration`. Optional (unset = every integration test
# skips when REQUIRE_INTEGRATION_TESTS is false). Must be a full URL that parses with
# `new URL()`, so the socket form `postgres://user@/db?host=/tmp/x` is rejected.
# Point it at a throwaway database: the suite creates and drops its own tables.
# TEST_DATABASE_URL=postgres://nse_pulse_test:test_only@127.0.0.1:5433/nse_pulse_test
#
# Fail instead of skipping when TEST_DATABASE_URL is missing. Accepts exactly `true` or
# `false`; anything else leaves it disabled. CI sets `true` so a database that never
# started cannot report a green job. Local runs usually want the default (off).
# REQUIRE_INTEGRATION_TESTS=false
#
# Opt-in for the live Mansa test (tests/manual/mansa-live.test.ts). Exactly `true` enables
# it, in addition to MANSA_API_KEY being set — so a key in this file never turns the normal
# `npm test` run into a paid API call. Everything else leaves the live block skipped.
# MANSA_LIVE_TESTS=false
#
# Migrations directory used by `npm run db:migrate` (see the entry above). Also honoured
# by the integration suite when it applies migrations to the test database.
